---
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header/Header';
import Footer from '../components/Footer/Footer';

interface Props {
  tittel: string;
  beskriving?: string;
  erArtikkel?: boolean;
  bilete?: string;
  /** Adressa til same artikkelen på det andre språket, om han finst. */
  spraakUrl?: string;
  sprak?: 'nn' | 'en';
}

const {
  tittel,
  beskriving = 'Full-stack-utviklar frå Vestlandet. .NET, Azure og moderne webutvikling.',
  erArtikkel = false,
  bilete = '/assets/img/me.jpg',
  spraakUrl,
  sprak = 'nn',
} = Astro.props;

const aktuellSti = Astro.url.pathname;
const erBlogg = aktuellSti.startsWith('/blog');

const siteUrl = Astro.site ? Astro.site.toString() : 'https://hawk-on.github.io';
const kanoniskUrl = new URL(aktuellSti, siteUrl).toString();
const bileteUrl = new URL(bilete.startsWith('http') ? bilete : bilete, siteUrl).toString();

const fullTittel =
  tittel === 'Håkon Hole Lønning' ? tittel : `${tittel} — Håkon Hole Lønning`;

// Umami: bloggen og CV-en held kvar sin eigen statistikkstraum
const umamiId = erBlogg
  ? 'fd43352d-8e75-4352-8f82-92eb8a269859'
  : 'b3e4a54f-39af-4b9c-94fc-e9d0880ea5c4';

// Språkkodar for metadata. <html lang> aleine held ikkje: Schema.org og Open
// Graph har kvar sin kode, og begge stod hardkoda til nynorsk. Den engelske
// omsetjinga ville då opplyst feil språk om seg sjølv til alle som les
// metadataa i staden for teksten.
const inLanguage = sprak === 'en' ? 'en-GB' : 'nn-NO';
const ogLocale = sprak === 'en' ? 'en_GB' : 'nn_NO';

const jsonLd = erArtikkel
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": tittel,
      "description": beskriving,
      "image": bileteUrl,
      "author": {
        "@type": "Person",
        "name": "Håkon Hole Lønning",
        "url": "https://github.com/hawk-on"
      },
      "url": kanoniskUrl,
      "inLanguage": inLanguage
    }
  : erBlogg
  ? {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "hawk-on",
      "url": new URL('/blog/', siteUrl).toString(),
      "inLanguage": inLanguage
    }
  : {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Håkon Hole Lønning",
      "jobTitle": "Full-stack Utviklar",
      "url": siteUrl,
      "sameAs": [
        "https://github.com/Hawk-on",
        "https://www.linkedin.com/in/hawkon"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressRegion": "Vestland",
        "addressCountry": "NO"
      }
    };
---

<!DOCTYPE html>
<html lang={sprak === 'en' ? "en" : "nn"}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/*
    'unsafe-inline' i script-src gjeld berre i dev. Byggjesteget
    scripts/csp-hashar.mjs byter han ut med SHA-256-hashar av dei faktiske
    inline-skripta, og stoppar bygget om noko ikkje er dekt.
    style-src held på 'unsafe-inline' med vilje: Shiki fargar med inline stilar.
  */}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://hawk-on.github.io; connect-src 'self' https://cloud.umami.is https://gateway.umami.is https://giscus.app; frame-src https://giscus.app; object-src 'none'; base-uri 'self'" />
  <meta name="description" content={beskriving} />
  <title>{fullTittel}</title>
  <link rel="canonical" href={kanoniskUrl} />
  {/* Fortel søkjemotorane at dei to versjonane er same teksten på ulikt språk.
      Utan desse blir dei rekna som to urelaterte sider, eller som duplikat. */}
  {spraakUrl && (
    <>
      <link rel="alternate" hreflang={sprak === 'nn' ? 'nn' : 'en'} href={kanoniskUrl} />
      <link rel="alternate" hreflang={sprak === 'nn' ? 'en' : 'nn'} href={new URL(spraakUrl, siteUrl).toString()} />
      <link rel="alternate" hreflang="x-default" href={sprak === 'nn' ? kanoniskUrl : new URL(spraakUrl, siteUrl).toString()} />
    </>
  )}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  <meta property="og:title" content={fullTittel} />
  <meta property="og:description" content={beskriving} />
  <meta property="og:url" content={kanoniskUrl} />
  <meta property="og:type" content={erArtikkel ? 'article' : 'website'} />
  <meta property="og:image" content={bileteUrl} />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTittel} />
  <meta name="twitter:description" content={beskriving} />
  <meta name="twitter:image" content={bileteUrl} />
  <link rel="icon" type="image/png" href="/assets/img/favicon.png" id="favicon" />
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico" />
  <link rel="alternate" type="application/rss+xml" title="RSS" href="/blog/rss.xml" />
  <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiId}></script>
  <ClientRouter />
  <script is:inline>
    function setTema() {
      try {
        var t = localStorage.getItem('theme');
        if (t) document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}

      var link = document.getElementById('favicon');
      if (!link) return;
      var theme = document.documentElement.getAttribute('data-theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var isDark = theme === 'dark' || (!theme && prefersDark);
      link.href = isDark ? '/assets/img/favicon-dark.png' : '/assets/img/favicon.png';
    }

    setTema();
    document.addEventListener('astro:after-swap', setTema);
  </script>
</head>
<body>
  <a href="#hovudinnhald" class="hopp-til-innhald">Hopp til innhald</a>

  <Header client:load aktuellSti={aktuellSti} spraakUrl={spraakUrl} sprak={sprak} />

  <main id="hovudinnhald">
    <slot />
  </main>

  <Footer sprak={sprak} />

</body>
</html>
