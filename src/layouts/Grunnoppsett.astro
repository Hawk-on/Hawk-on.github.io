---
import '../styles/global.css';

import { Image } from 'astro:assets';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header/Header';
import Footer from '../components/Footer/Footer';

interface Props {
  tittel: string;
  beskriving?: string;
}

const {
  tittel,
  beskriving = 'Full-stack-utviklar frå Bergen. .NET, Azure og moderne webutvikling.',
} = Astro.props;

const kanoniskUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;
const fullTittel =
  tittel === 'Håkon Hole Lønning' ? tittel : `${tittel} — Håkon Hole Lønning`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Håkon Hole Lønning",
  "jobTitle": "Full-stack Utviklar",
  "url": "https://hawk-on.github.io",
  "sameAs": [
    "https://github.com/Hawk-on",
    "https://www.linkedin.com/in/hawkon"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Bergen",
    "addressCountry": "NO"
  }
};
---

<!DOCTYPE html>
<html lang="nn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={beskriving} />
  <title>{fullTittel}</title>
  <link rel="canonical" href={kanoniskUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <meta property="og:title" content={fullTittel} />
  <meta property="og:description" content={beskriving} />
  <meta property="og:url" content={kanoniskUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://hawk-on.github.io/assets/img/me.jpg" />
  <meta property="og:locale" content="nn_NO" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTittel} />
  <meta name="twitter:description" content={beskriving} />
  <meta name="twitter:image" content="https://hawk-on.github.io/assets/img/me.jpg" />
  <link rel="icon" type="image/png" href="/assets/img/favicon.png" id="favicon" />
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico" />
  <script
    defer
    src="https://cloud.umami.is/script.js"
    data-website-id="b3e4a54f-39af-4b9c-94fc-e9d0880ea5c4"
  ></script>
  <ViewTransitions />
  <script is:inline>
    function setTema() {
      try {
        var t = localStorage.getItem('theme');
        if (t) document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}

      function oppdaterFavicon() {
        var link = document.getElementById('favicon');
        if (!link) return;
        var html = document.documentElement;
        var theme = html.getAttribute('data-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var isDark = theme === 'dark' || (!theme && prefersDark);
        link.href = isDark
          ? '/assets/img/favicon-dark.png'
          : '/assets/img/favicon.png';
      }
      oppdaterFavicon();
    }

    setTema();
    document.addEventListener('astro:after-swap', setTema);
  </script>
</head>
<body>
  <a href="#hovudinnhald" class="hopp-til-innhald">Hopp til innhald</a>

  <Header client:load />

  <main id="hovudinnhald">
    <slot />
  </main>

  <Footer />

</body>
</html>
</html>
