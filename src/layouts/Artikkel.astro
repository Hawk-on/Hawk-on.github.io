---
import { BLOGG_BASE } from '../utils/rutar';
import Grunnoppsett from './Grunnoppsett.astro';
import { formaterDato } from '../utils/dato';
import GiscusKommentarar from '../components/GiscusKommentarar/GiscusKommentarar';
import ArtikkelMeta from '../components/ArtikkelMeta/ArtikkelMeta';
import Innhaldstabell from '../components/Innhaldstabell/Innhaldstabell';
import LeseProgresjon from '../components/LeseProgresjon/LeseProgresjon';
import KjeldeInfo from '../components/ArtikkelMeta/KjeldeInfo';
import { getCollection } from 'astro:content';
import { bloggTekst } from '../utils/i18n-blogg';

interface Props {
  spraakUrl?: string;
  frontmatter: {
    slug?: string;
    tittel: string;
    publisertDato: string | Date;
    oppdatertDato?: string | Date;
    ingress?: string;
    tags?: string[];
    lesetid?: number;
    bilete?: string;
    sprak?: 'nn' | 'en';
  }
}

const { frontmatter, spraakUrl } = Astro.props;
const { tittel, publisertDato, oppdatertDato, ingress, tags = [], lesetid, bilete } = frontmatter;
const sprak = frontmatter.sprak ?? 'nn';
const t = bloggTekst(sprak);
const base = BLOGG_BASE;
const aktuellSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';

const datoFormatert = formaterDato(publisertDato, 'lang', sprak);
const oppdatertFormatert = oppdatertDato ? formaterDato(oppdatertDato, 'lang', sprak) : undefined;

// Finn relaterte artiklar basert på tags.
//
// Språkfilteret er ikkje pynt. Dei to versjonane av same artikkel deler alle
// taggane, så utan det ville ein artikkel tilrådd si eiga omsetjing som
// næraste slektning, og nynorske lesarar fått engelske treff i lista.
const alleInnlegg = await getCollection('blog', ({ data }) => {
  return (import.meta.env.DEV || !data.utkast)
    && data.tittel !== tittel
    && (data.sprak ?? 'nn') === sprak;
});

const relaterteInnlegg = alleInnlegg
  .map(innlegg => {
    const fellesTags = innlegg.data.tags.filter(t => tags.includes(t)).length;
    return { ...innlegg, fellesTags };
  })
  .filter(innlegg => innlegg.fellesTags > 0)
  .sort((a, b) => {
    const datoA = a.data.oppdatertDato ?? a.data.publisertDato;
    const datoB = b.data.oppdatertDato ?? b.data.publisertDato;
    return b.fellesTags - a.fellesTags || datoB.valueOf() - datoA.valueOf();
  })
  .slice(0, 3);
---

<Grunnoppsett tittel={tittel} beskriving={ingress} erArtikkel={true} bilete={bilete} spraakUrl={spraakUrl} sprak={sprak}>
  <div class="container">
    <header class="artikkel-header">
      <ArtikkelMeta 
        datoFormatert={datoFormatert} 
        oppdatertFormatert={oppdatertFormatert}
        lesetid={lesetid} 
        tags={tags} 
        base={base} 
        sprak={sprak}
      />
      <h1 class="artikkel-header__tittel">{tittel}</h1>
      {ingress && <p class="artikkel-header__ingress">{ingress}</p>}
    </header>

    <Innhaldstabell client:idle sprak={sprak} key={aktuellSlug} />

    <article class="artikkel-kropp" id="artikkel-kropp" data-pagefind-body>
      <slot />
    </article>

    {relaterteInnlegg.length > 0 && (
      <section class="relaterte-artiklar">
        <h2 class="seksjon-tittel">{t.lesMeir}</h2>
        <ul class="artikkel-liste">
          {relaterteInnlegg.map(innlegg => (
            <li class="artikkel-kort artikkel-kort--sm">
              <div class="artikkel-kort__dato">{formaterDato(innlegg.data.publisertDato, 'kort', sprak)}</div>
              <div>
                <h3 class="artikkel-kort__tittel">
                  <a href={`${base}/${innlegg.id}/`}>{innlegg.data.tittel}</a>
                </h3>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <GiscusKommentarar client:only="react" term={aktuellSlug} key={aktuellSlug} />

    <LeseProgresjon client:idle manueltLesetid={lesetid} sprak={sprak} key={aktuellSlug} />

    <KjeldeInfo client:load sprak={sprak} />

    <nav class="artikkel-tilbake-nav">
      <a href={`${base}/`} class="artikkel-tilbake-lenke" data-umami-event="artikkel-tilbake">
        {t.tilbake}
      </a>
    </nav>
  </div>
</Grunnoppsett>

<script>
  // Fotnote Preview og Kvalitets-logikk
  function initKjeldeSystem() {
    const referansar = document.querySelectorAll<HTMLAnchorElement>('a[href^="#ref-"]');
    const fargar = { 'A': '#10b981', 'B': '#3b82f6', 'C': '#f59e0b', 'D': '#ef4444' };
    
    referansar.forEach(ref => {
      if (ref.dataset.kjeldeInit === 'true') return;
      ref.dataset.kjeldeInit = 'true';

      const targetId = ref.getAttribute('href')?.substring(1);
      if (!targetId) return;
      const targetSpan = document.getElementById(targetId);
      if (!targetSpan) return;

      const kvalitet = targetSpan.getAttribute('data-kvalitet');
      const habilitet = targetSpan.getAttribute('data-habilitet');

      // Legg til badgar i teksten
      if (!ref.querySelector('.kjelde-badge')) {
        if (kvalitet && fargar[kvalitet as keyof typeof fargar]) {
          const b1 = document.createElement('span');
          b1.className = 'kjelde-badge';
          b1.style.backgroundColor = fargar[kvalitet as keyof typeof fargar];
          b1.textContent = kvalitet;
          b1.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            window.dispatchEvent(new CustomEvent('opne-kjeldeinfo'));
          };
          ref.appendChild(b1);
        }
        if (habilitet) {
          const b2 = document.createElement('span');
          b2.className = 'kjelde-badge kjelde-badge--habilitet';
          b2.textContent = habilitet;
          b2.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            window.dispatchEvent(new CustomEvent('opne-kjeldeinfo'));
          };
          ref.appendChild(b2);
        }
      }

      // Hover og fokus preview-logikk
      const visPreview = (e: Event) => {
        const kjeldeTekst = targetSpan.nextSibling?.textContent || targetSpan.parentElement?.textContent?.split(']')[1] || '';
        if (!kjeldeTekst.trim()) return;

        document.querySelectorAll('.fotnote-preview').forEach(p => p.remove());

        const preview = document.createElement('div');
        preview.className = 'fotnote-preview';
        
        // Bygd med DOM-nodar, ikkje innerHTML. kjeldeTekst kjem frå textContent i
        // artikkelen, og ein kjeldetekst som inneheld HTML-escapa markup vil då
        // koma attende med ekte vinkelparentesar. Sett inn via innerHTML ville
        // nettlesaren tolka han som markup på nytt.
        if (kvalitet || habilitet) {
          const header = document.createElement('div');
          header.style.cssText = 'display:flex; gap:0.5rem; margin-bottom:0.75rem; border-bottom:1px solid #eee; padding-bottom:0.5rem;';
          if (kvalitet) {
            const boks = document.createElement('div');
            const merke = document.createElement('span');
            merke.className = 'kjelde-badge';
            merke.style.margin = '0';
            merke.style.background = fargar[kvalitet as keyof typeof fargar] ?? '';
            merke.textContent = kvalitet;
            boks.appendChild(merke);
            header.appendChild(boks);
          }
          if (habilitet) {
            const boks = document.createElement('div');
            const merke = document.createElement('span');
            merke.className = 'kjelde-badge kjelde-badge--habilitet';
            merke.style.margin = '0';
            merke.textContent = habilitet;
            boks.appendChild(merke);
            header.appendChild(boks);
          }
          preview.appendChild(header);
        }

        const kropp = document.createElement('div');
        kropp.style.fontStyle = 'italic';
        kropp.textContent = kjeldeTekst.trim();
        preview.appendChild(kropp);
        
        const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
        preview.style.top = `${rect.top + window.scrollY - 10}px`;
        preview.style.left = `${rect.left + window.scrollX}px`;
        document.body.appendChild(preview);

        const removePreview = () => {
          preview.remove();
          ref.removeEventListener('mouseleave', removePreview);
          ref.removeEventListener('blur', removePreview);
        };
        ref.addEventListener('mouseleave', removePreview);
        ref.addEventListener('blur', removePreview);
      };

      ref.addEventListener('mouseenter', visPreview);
      ref.addEventListener('focus', visPreview);
    });
  }

  document.addEventListener('astro:page-load', initKjeldeSystem);
</script>

<style is:global>
  .fotnote-preview {
    position: absolute;
    transform: translateY(-100%);
    background: var(--kvit);
    border: 1px solid var(--lys-grå);
    padding: 1rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    max-width: 380px;
    font-size: 0.85rem;
    line-height: 1.5;
    z-index: 1000;
    pointer-events: none;
    font-family: var(--skrift-brød);
    border-top: 2px solid var(--raud);
    border-radius: 2px;
  }

  html[data-theme="dark"] .fotnote-preview {
    background: #252220;
    color: #e8e2d8;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    border-color: #444;
  }

  @media (prefers-color-scheme: dark) {
    html:not([data-theme="light"]) .fotnote-preview {
      background: #252220;
      color: #e8e2d8;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border-color: #444;
    }
  }
</style>
