---
import Grunnoppsett from '../layouts/Grunnoppsett.astro';
import { Image } from 'astro:assets';
import profilBilete from '../assets/me.jpg';
import Kontakt from '../components/Kontakt/Kontakt';
import BloggSveip from '../components/BloggSveip/BloggSveip';
---

<Grunnoppsett tittel="Håkon Hole Lønning">
  <div class="container">

    <!-- Hero -->
    <section class="cv-hero" id="hero">
      <p class="cv-hero__kicker" data-i18n="hero.kicker">Full-Stack Utviklar · .NET · Azure</p>
      <div class="cv-hero__indre">
        <div class="cv-hero__tekst">
          <h1 class="cv-hero__namn">Håkon Hole Lønning</h1>
          <p class="cv-hero__rolle" data-i18n="hero.role">Full-Stack Utviklar</p>
          <p class="cv-hero__beskriving" data-i18n="hero.description">
            .NET, Azure og moderne webutvikling. Eg likar å lære nye domene og byggje robuste løysingar som skapar verdi.
          </p>
          <div class="cv-hero__knappar">
            <a href="#kontakt" class="knapp knapp--fylt" data-i18n="hero.contact" data-umami-event="cta-kontakt">Kontakt meg</a>
            <a href="#erfaring" class="knapp" data-i18n="hero.experience" data-umami-event="cta-erfaring">Sjå erfaring</a>
          </div>
        </div>
        <Image src={profilBilete} alt="Håkon Hole Lønning" class="cv-hero__foto" loading="eager" />
      </div>
    </section>

    <!-- Om meg -->
    <section id="om" class="innfading">
      <p class="seksjon-kicker" data-i18n="section.about">Om meg</p>
      <p data-i18n="about.p1">
        Eg bur med kone og born i Bergen, men kjem opphavleg frå Osterøy. Fritida mi liker eg å bruke på PC, fiske og turar i fjell og skog.
      </p>
      <p data-i18n="about.p2">
        Det som driv meg innan programutvikling er gleda av å lære nye domene og teknologiar. Det fantastiske med dette faget er variasjonen og den konstante straumen av nye ting å lære.
      </p>
    </section>

    <!-- Erfaring -->
    <section id="erfaring" class="innfading">
      <p class="seksjon-kicker" data-i18n="section.experience">Arbeidserfaring</p>
      <div class="tidslinje">

        <div class="tidslinje-item">
          <div class="tidslinje-item__dato" data-i18n="job1.date">Juni 2024 – No</div>
          <div>
            <h2 class="tidslinje-item__rolle" data-i18n="job.developer">Utviklar</h2>
            <p class="tidslinje-item__stad">Folkehelseinstituttet · Bergen</p>
            <p class="tidslinje-item__beskriving" data-i18n="job1.desc">Arbeider med moderne helseteknologi, inkludert ny plattform på Azure Arc og Kubernetes.</p>
            <div class="etikkettar">
              <span class="etikett">ASP.NET Core</span>
              <span class="etikett">C#</span>
              <span class="etikett">Azure Arc</span>
              <span class="etikett">Kubernetes</span>
              <span class="etikett">TypeScript</span>
              <span class="etikett">Angular</span>
              <span class="etikett">Docker</span>
            </div>
          </div>
        </div>

        <div class="tidslinje-item">
          <div class="tidslinje-item__dato" data-i18n="job2.date">Nov 2021 – Mai 2024</div>
          <div>
            <h2 class="tidslinje-item__rolle" data-i18n="job.developer">Utviklar</h2>
            <p class="tidslinje-item__stad">Helse Vest IKT · Bergen</p>
            <p class="tidslinje-item__beskriving" data-i18n="job2.desc">Jobba med genetikkportalen.no og simple.no.</p>
            <div class="etikkettar">
              <span class="etikett">Angular</span>
              <span class="etikett">.NET Core</span>
              <span class="etikett">Azure AD</span>
              <span class="etikett">Bicep</span>
              <span class="etikett">Web API</span>
            </div>
          </div>
        </div>

        <div class="tidslinje-item">
          <div class="tidslinje-item__dato" data-i18n="job3.date">Aug 2019 – Nov 2021</div>
          <div>
            <h2 class="tidslinje-item__rolle" data-i18n="job.fullstack">Full-Stack Utviklar</h2>
            <p class="tidslinje-item__stad">Acos AS · Øygarden</p>
            <p class="tidslinje-item__beskriving" data-i18n="job3.desc">Jobba med sjølvbeteningsløysing (Interact) og prosessflytverktøy (Interact Flow).</p>
            <div class="etikkettar">
              <span class="etikett">VB.NET</span>
              <span class="etikett">Angular</span>
              <span class="etikett">TypeScript</span>
              <span class="etikett">ASP.NET Core</span>
            </div>
          </div>
        </div>

        <div class="tidslinje-item">
          <div class="tidslinje-item__dato" data-i18n="job4.date">Des 2012 – Aug 2019</div>
          <div>
            <h2 class="tidslinje-item__rolle" data-i18n="job4.title">Vektar</h2>
            <p class="tidslinje-item__stad">Avarn Security · Bergen</p>
            <p class="tidslinje-item__beskriving" data-i18n="job4.desc">Hadde mange forskjellige oppdrag. Objektleiar, mobilvektar, områdevektar, arrangementsvakthald.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- Utdanning -->
    <section id="utdanning" class="innfading">
      <p class="seksjon-kicker" data-i18n="section.education">Utdanning</p>
      <div class="utdanning-grid">

        <div class="utdanning-kort">
          <p class="utdanning-kort__dato" data-i18n="edu1.date">Aug 2015 – Juni 2019</p>
          <h3 class="utdanning-kort__tittel" data-i18n="edu1.title">Bachelor i informasjonsvitskap</h3>
          <p class="utdanning-kort__stad">Høgskulen på Vestlandet (HVL)</p>
        </div>

        <div class="utdanning-kort">
          <p class="utdanning-kort__dato" data-i18n="edu2.date">Aug 2011 – Des 2012</p>
          <h3 class="utdanning-kort__tittel" data-i18n="edu2.title">Grunnskolelærarutdanning 5–10</h3>
          <p class="utdanning-kort__stad">Høgskolen i Bergen (HiB)</p>
        </div>

        <div class="utdanning-kort">
          <p class="utdanning-kort__dato" data-i18n="edu3.date">Aug 2009 – Juni 2011</p>
          <h3 class="utdanning-kort__tittel" data-i18n="edu3.title">Bachelor i engelsk</h3>
          <p class="utdanning-kort__stad">Universitetet i Bergen (UiB)</p>
        </div>

        <div class="utdanning-kort">
          <p class="utdanning-kort__dato" data-i18n="edu4.date">Aug 2003 – Juni 2007</p>
          <h3 class="utdanning-kort__tittel" data-i18n="edu4.title">Tekniske og allmenne fag (TAF)</h3>
          <p class="utdanning-kort__stad">Knarvik vidaregåande skule</p>
          <p class="utdanning-kort__merknad" data-i18n="edu4.desc">Studiekompetanse og fagbrev som maskinarbeidar.</p>
        </div>

      </div>
    </section>

    <!-- Ferdigheiter -->
    <section id="ferdigheiter" class="innfading">
      <p class="seksjon-kicker" data-i18n="section.skills">Ferdigheiter</p>
      <div class="ferdigheiter-wrapper">

        <div class="ferdigheit-kategori">
          <p class="ferdigheit-kategori__tittel" data-i18n="skills.languages">Språk</p>
          <ul class="ferdigheit-liste">
            <li data-i18n="lang.norwegian">Norsk (Nynorsk)</li>
            <li data-i18n="lang.english">Engelsk (God)</li>
          </ul>
        </div>

        <div class="ferdigheit-kategori">
          <p class="ferdigheit-kategori__tittel" data-i18n="skills.tech">Teknologiar</p>
          <div class="etikkettar">
            <span class="etikett">C# / .NET</span>
            <span class="etikett">Azure</span>
            <span class="etikett">Angular</span>
            <span class="etikett">TypeScript</span>
            <span class="etikett">Kubernetes</span>
            <span class="etikett">Azure Arc</span>
            <span class="etikett">Docker</span>
            <span class="etikett">SQL</span>
            <span class="etikett">Git</span>
          </div>
        </div>

      </div>
    </section>

    <!-- Siste frå bloggen -->
    <BloggSveip client:idle />

    <!-- Kontakt -->
    <section id="kontakt" class="innfading">
      <p class="seksjon-kicker" data-i18n="section.contact">Ta kontakt</p>
      <p class="kontakt-intro" data-i18n="contact.desc">Eg er alltid interessert i ein prat om teknologi og moglegheiter.</p>
      
      <Kontakt client:load />
    </section>

  </div>
</Grunnoppsett>

<script>
  import { spraakStore } from '../stores/spraakStore';
  import { omsetjingar } from '../utils/i18n';

  function oppdaterInnhald() {
    const aktivSpraak = spraakStore.get();
    document.documentElement.lang = aktivSpraak === 'no' ? 'nn' : 'en';
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const nøkkel = el.getAttribute('data-i18n');
      if (!nøkkel) return;
      const verdi = nøkkel.split('.').reduce((o: any, k) => o && o[k], omsetjingar[aktivSpraak]);
      if (el instanceof HTMLElement && verdi) {
        el.textContent = verdi;
      }
    });
  }

  // Initial oppdatering og lytt på endringar
  document.addEventListener('astro:page-load', () => {
    oppdaterInnhald();
    spraakStore.subscribe(() => {
      oppdaterInnhald();
    });
  });
</script>

<script is:inline>
  function initAnimasjonar() {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('synleg');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.innfading').forEach(function (el) {
      observer.observe(el);
    });
  }

  function initNavScroll() {
    var seksjonar = document.querySelectorAll('section[id]');
    var navLenker = document.querySelectorAll('.nettstad-nav a[href^="#"]');

    window.addEventListener('scroll', function () {
      var scrollY = window.scrollY;
      var aktivSeksjon = '';
      seksjonar.forEach(function (s) {
        if (scrollY >= s.offsetTop - 120) aktivSeksjon = s.id;
      });
      navLenker.forEach(function (a) {
        a.classList.toggle('aktiv', a.getAttribute('href') === '#' + aktivSeksjon);
      });
    }, { passive: true });
  }

  // Sørg for at alt køyrer ved kvar navigering
  document.addEventListener('astro:page-load', () => {
    initAnimasjonar();
    initNavScroll();
  });
</script>
