---
import { BLOGG_BASE } from '../../../utils/rutar';
import { getCollection } from 'astro:content';
import Grunnoppsett from '../../../layouts/Grunnoppsett.astro';
import { formaterDato } from '../../../utils/dato';
import { kanoniskTag, kanoniskeTaggar, visTag, gamleTagStiar } from '../../../utils/taggar';

export async function getStaticPaths() {
  const innlegg = await getCollection('blog', ({ data }) => {
    return import.meta.env.DEV || !data.utkast;
  });
  const alleRå = innlegg.flatMap(i => i.data.tags ?? []);
  const unikeTaggar = [...new Set(alleRå.map(kanoniskTag))];

  return [
    ...unikeTaggar.map(tag => ({
      params: { tag },
      props: {
        innlegg: innlegg.filter(i => kanoniskeTaggar(i.data.tags).includes(tag)),
        tag,
        omdiriger: null as string | null,
      },
    })),
    // Gamle adresser held fram med å svare, som meta-refresh til den nye.
    ...gamleTagStiar(alleRå).map(({ frå, til }) => ({
      params: { tag: frå },
      props: { innlegg: [], tag: frå, omdiriger: `${BLOGG_BASE}/tag/${til}/` },
    })),
  ];
}

const { innlegg, tag, omdiriger } = Astro.props;
const base = BLOGG_BASE;
const sortertInnlegg = innlegg.sort((a, b) => {
  const datoA = a.data.oppdatertDato ?? a.data.publisertDato;
  const datoB = b.data.oppdatertDato ?? b.data.publisertDato;
  return datoB.valueOf() - datoA.valueOf();
});
const absolutt = omdiriger
  ? new URL(omdiriger, Astro.site ?? 'https://hawk-on.github.io').toString()
  : '';
---

{omdiriger ? (
  <html lang="nn">
    <head>
      <meta charset="UTF-8" />
      <meta http-equiv="refresh" content={`0; url=${omdiriger}`} />
      <link rel="canonical" href={absolutt} />
      <meta name="robots" content="noindex" />
      <title>Flytta — Håkon Hole Lønning</title>
    </head>
    <body>
      <p>Taggen har flytta til <a href={omdiriger}>{omdiriger}</a>.</p>
      <script is:inline define:vars={{ omdiriger }}>
        window.location.replace(omdiriger);
      </script>
    </body>
  </html>
) : (
  <Grunnoppsett tittel={`#${visTag(tag)}`} beskriving={`Alle innlegg merka med ${visTag(tag)}`}>
    <div class="container">
      <div class="tag-header">
        <p class="seksjon-tittel"><a href={base} class="tag-header__tilbake">Alle innlegg</a></p>
        <h1 class="tag-header__tittel">#{visTag(tag)}</h1>
        <p class="tag-header__tal">
          {sortertInnlegg.length} {sortertInnlegg.length === 1 ? 'innlegg' : 'innlegg'}
        </p>
      </div>

      <ul class="artikkel-liste">
        {sortertInnlegg.map(innlegg => {
          const { tittel, publisertDato, ingress } = innlegg.data;
          const datoFormatert = formaterDato(publisertDato);
          const slug = innlegg.id;
          const taggar = kanoniskeTaggar(innlegg.data.tags);
          return (
            <li class="artikkel-kort">
              <div class="artikkel-kort__dato">{datoFormatert}</div>
              <div>
                <h2 class="artikkel-kort__tittel">
                  <a href={`${base}/${slug}`}>{tittel}</a>
                </h2>
                {ingress && <p class="artikkel-kort__ingress">{ingress}</p>}
                {taggar.length > 0 && (
                  <div class="artikkel-kort__tags">
                    {taggar.map((t: string) => (
                      <a href={`${base}/tag/${t}`} class="tag" data-umami-event="tagg-klikk" data-umami-event-tag={t}>{visTag(t)}</a>
                    ))}
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </Grunnoppsett>
)}
