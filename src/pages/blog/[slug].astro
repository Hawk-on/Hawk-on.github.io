---
import { getCollection, render } from 'astro:content';
import Artikkel from '../../layouts/Artikkel.astro';
import { reknaUtLesetid } from '../../utils/tekst';
import { kanoniskeTaggar } from '../../utils/taggar';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => {
    return import.meta.env.DEV || !data.utkast;
  });
  return blogEntries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const frontmatter = {
  ...entry.data,
  tags: kanoniskeTaggar(entry.data.tags),
  lesetid: reknaUtLesetid(entry.body ?? '')
};
---

<Artikkel frontmatter={frontmatter}>
  <Content />
</Artikkel>
