---
import { getCollection, render } from 'astro:content';
import Artikkel from '../../layouts/Artikkel.astro';
import { reknaUtLesetid } from '../../utils/tekst';
import { kanoniskeTaggar } from '../../utils/taggar';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => {
    return import.meta.env.DEV || !data.utkast;
  });
  const etterSlug = new Map(blogEntries.map(e => [e.id, e]));
  return blogEntries.map(entry => {
    // Finn makkeren på det andre språket, om han finst.
    const basis = entry.data.omsetjing;
    const makkerId = basis
      ? (entry.data.sprak === 'en' ? basis : `en/${basis}`)
      : undefined;
    const makker = makkerId ? etterSlug.get(makkerId) : undefined;
    return {
      params: { slug: entry.id },
      props: { entry, spraakUrl: makker ? `/blog/${makker.id}/` : undefined },
    };
  });
}

const { entry, spraakUrl } = Astro.props;
const { Content } = await render(entry);

const frontmatter = {
  ...entry.data,
  tags: kanoniskeTaggar(entry.data.tags),
  lesetid: reknaUtLesetid(entry.body ?? '')
};
---

<Artikkel frontmatter={frontmatter} spraakUrl={spraakUrl}>
  <Content />
</Artikkel>
