---
// Redirect-stubbar frå den gamle bloggstien (/Blog/ med stor B) til /blog/.
//
// Bloggen låg tidlegare i eit eige repo som eigde stien /Blog/ på GitHub Pages.
// Etter samanslåinga ligg han under /blog/, og desse sidene held gamle lenkjer,
// bokmerke og søkjemotortreff i live. GitHub Pages har ingen serverside-redirects,
// så dette må gjerast med meta-refresh pluss ein canonical-peikar.
//
// Stiane er skilde berre av bokstavstorleik, og GitHub Pages skil på det, så
// /Blog/... og /blog/... kan eksistere side om side.
import { getCollection } from 'astro:content';
import { kanoniskTag } from '../../utils/taggar';

export async function getStaticPaths() {
  const innlegg = await getCollection('blog', ({ data }) => !data.utkast && data.sprak !== 'en');

  // Både den kanoniske slugen og rå-taggen skal svare. Dei gamle adressene under
  // /Blog/ vart laga frå frontmatter slik han stod, altså /Blog/tag/AI/ og ikkje
  // /Blog/tag/ai/. Normaliserer me før me lagar stubbane, daudar nett dei lenkjene
  // normaliseringa skulle berge. Begge peikar på same kanoniske målet.
  const stubbar = new Map<string, string>();
  for (const rå of innlegg.flatMap(i => i.data.tags ?? [])) {
    const kanonisk = kanoniskTag(rå);
    stubbar.set(kanonisk, kanonisk);
    stubbar.set(rå, kanonisk);
  }

  return [
    { params: { sti: undefined }, props: { mal: '/blog/' } },
    ...innlegg.map(i => ({ params: { sti: i.id }, props: { mal: `/blog/${i.id}/` } })),
    ...[...stubbar].map(([frå, til]) => ({
      params: { sti: `tag/${frå}` },
      props: { mal: `/blog/tag/${til}/` },
    })),
  ];
}

const { mal } = Astro.props;
const absolutt = new URL(mal, Astro.site ?? 'https://hawk-on.github.io').toString();
---

<!DOCTYPE html>
<html lang="nn">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${mal}`} />
  <link rel="canonical" href={absolutt} />
  <meta name="robots" content="noindex" />
  <title>Flytta — Håkon Hole Lønning</title>
</head>
<body>
  <p>Sida har flytta til <a href={mal}>{mal}</a>.</p>
  <script is:inline define:vars={{ mal }}>
    window.location.replace(mal);
  </script>
</body>
</html>
