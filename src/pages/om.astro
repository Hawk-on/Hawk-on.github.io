---
import { BLOGG_BASE } from '../utils/rutar';
import Grunnoppsett from '../layouts/Grunnoppsett.astro';
const base = BLOGG_BASE;
---

<Grunnoppsett tittel="Om" beskriving="Om hawk-on">
  <div class="container--brei">
    <div class="om-grid">
      <div>
        <div class="om-header">
          <p class="seksjon-tittel">Om</p>
          <h1 class="om-header__tittel">
            hawk-on
          </h1>
        </div>

        <p>
          Eg er seniorrådgjevar med bakgrunn frå helsesektoren, og bur på Vestlandet. Til dagleg arbeider eg med .NET, C# og
          skybasert infrastruktur.
        </p>

        <p>
          På denne bloggen skriv eg om det som opptek meg utanfor koden:
          politisk økonomi, geopolitikk, norsk arbeidsliv og
          teknologiens rolle i maktstrukturar. Eg nærmar meg desse temaa
          med ein strukturalistisk linse. Eg er meir interessert i system
          enn i einskildpersonar.
        </p>

        <h2>Kontakt</h2>
        <p>
          Du finn meg på
          <a href="https://github.com/hawk-on">GitHub</a>.
        </p>
      </div>

      <aside>
        <div class="om-sidebar-boks">
          <p class="om-sidebar-boks__tittel">Fagleg bakgrunn</p>
          <ul class="om-sidebar-boks__liste">
            <li>.NET Core / C#</li>
            <li>Angular</li>
            <li>Kubernetes / Docker</li>
            <li>Azure DevOps</li>
            <li>HelseID / OIDC</li>
            <li>GitOps / Flux</li>
          </ul>
        </div>

        <div class="om-abonner-boks">
          <p class="om-sidebar-boks__tittel">Abonner</p>
          <p class="om-abonner-boks__tekst">
            Nye innlegg via RSS
          </p>
          <a href={`${base}/rss.xml`} class="om-abonner-boks__lenke">RSS-feed →</a>
        </div>
      </aside>
    </div>
  </div>
</Grunnoppsett>

<style>
  /* Klassane under vart brukte i markupen utan å vera definerte nokon stad.
     Sida fall difor attende på nettlesarens standardstilar: ingen grid, så
     sidestolpen låg under teksten, og boksane var umerkte.

     Stilen ligg her og ikkje i global.css fordi han gjeld denne eine sida.
     Fargar og skrifter kjem frå designtokena, så mørk modus fylgjer med. */

  .om-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  @media (min-width: 60rem) {
    .om-grid {
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 4rem;
    }
  }

  .om-header {
    margin-bottom: 2rem;
  }

  .om-header__tittel {
    font-size: clamp(1.8rem, 4vw, 3rem);
    margin-bottom: 0;
  }

  .om-sidebar-boks,
  .om-abonner-boks {
    border-left: 2px solid var(--lys-grå);
    padding-left: 1.2rem;
    margin-bottom: 2.5rem;
  }

  .om-sidebar-boks__tittel {
    font-family: var(--skrift-kode);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--grå);
    margin-bottom: 0.9rem;
  }

  .om-sidebar-boks__liste {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.95rem;
    color: var(--tekst-sekundar);
  }

  .om-sidebar-boks__liste li {
    padding-bottom: 0.45rem;
  }

  .om-abonner-boks__tekst {
    font-size: 0.95rem;
    color: var(--tekst-sekundar);
    margin-bottom: 0.6rem;
  }

  .om-abonner-boks__lenke {
    font-family: var(--skrift-kode);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--raud);
    text-decoration: none;
  }

  .om-abonner-boks__lenke:hover,
  .om-abonner-boks__lenke:focus-visible {
    text-decoration: underline;
  }
</style>
